# ===== Runtime =====
APP_HOST=0.0.0.0
APP_PORT=8092
# true=只打日志，不真正推送给值班同事
SAFE_MODE=true
LOG_LEVEL=INFO
DATA_DIR=./data
# groups.yaml：群 → 值班支持号映射
GROUPS_CONFIG=./config/groups.yaml

# ===== 扫描策略 =====
# 每隔多少分钟扫描一次「超时未回复」
SCAN_INTERVAL_MINUTES=10
# 客户最后一条消息超过多少分钟仍无内部同事回复，视为待跟进
UNANSWERED_MINUTES=10
# 同一条客户消息的提醒冷却（分钟），避免反复轰炸
ALERT_COOLDOWN_MINUTES=30
# 工作时间（本地时区），非工作时间不提醒；留空则 7x24
WORK_HOURS_START=09:00
WORK_HOURS_END=22:00
TIMEZONE=Asia/Shanghai

# ===== 消息来源 =====
# webhook | demo
# webhook：会话存档转发器 / 群机器人 / RPA / SentLink 推送到 POST /ingest/messages
# demo：内置样例数据，本地可直接跑通全流程
MESSAGE_SOURCE=demo
# 可选：保护 ingest 接口（Header: X-Ingest-Token 或 Authorization: Bearer）
INGEST_TOKEN=

# ===== 企业微信（通知支持号）=====
WECOM_CORP_ID=wwxxxxxxxx
# 自建应用 Secret（需有「发送应用消息」权限）
WECOM_APP_SECRET=xxxxxxxx
WECOM_AGENT_ID=1000002
# 可选：额外打到内部值班群机器人
WECOM_NOTIFY_WEBHOOK=

# 飞书自定义机器人（可选；不配则只走企微应用消息推小东/小杭）
FEISHU_NOTIFY_WEBHOOK=
# 通用 JSON Webhook（邮件/短信网关等）
GENERIC_NOTIFY_WEBHOOK=

# ===== 建议回复来源（不用 MaxKB）=====
# none | sync_webhook | local_cmd | ai_gateway
# none：仅发对话摘要 + 通用建议
# sync_webhook：POST WorkBuddy，同步返回 { "suggestion": "..." }
# local_cmd：本机 WorkBuddy skill 脚本
# ai_gateway：公司 OpenAI 兼容网关（推荐）
WORKBUDDY_MODE=ai_gateway
WORKBUDDY_WEBHOOK_URL=http://127.0.0.1:8093/workbuddy/suggest
WORKBUDDY_WEBHOOK_TOKEN=
WORKBUDDY_TIMEOUT_SECONDS=60
WORKBUDDY_LOCAL_CMD=
SUGGEST_SYSTEM_HINT=你是售后一线助手。根据客户群最新未回复内容，结合知识库给出：1)问题摘要 2)建议回复话术 3)仍需向客户确认的信息。不要编造未在知识库中的结论。

# ===== 公司 AI 网关（WORKBUDDY_MODE=ai_gateway）=====
AI_GATEWAY_BASE_URL=https://ai.fit2cloud.cn/gateway/v1
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=f2c-auto
# 告警前 AI 再判是否需跟进（true/false）
FOLLOWUP_AI_JUDGE=true

